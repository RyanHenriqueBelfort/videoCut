# Copie para .env e ajuste.

# Quem escolhe os cortes: claude = Claude Code (assinatura, sem chave de API); agent = só via chat/MCP (/cortar); ollama = LLM local
VIDEOCUT_SELECTOR=claude
# VIDEOCUT_CLAUDE_MODEL=   # vazio = modelo padrão da sua conta
# VIDEOCUT_UI_PORT=8765

# LLM local (Ollama, opcional). Na RTX 5070 (12 GB) cabem bem: qwen2.5:14b, qwen3:14b, gemma3:12b
VIDEOCUT_LLM=qwen2.5:14b
OLLAMA_URL=http://127.0.0.1:11434

# Transcrição: faster-whisper (local) ou voicestudio (usa o WhisperX do VoiceStudio)
VIDEOCUT_TRANSCRIBER=faster-whisper
VIDEOCUT_WHISPER_MODEL=large-v3-turbo
VIDEOCUT_WHISPER_DEVICE=auto
# VIDEOCUT_LANGUAGE=pt

# Duração dos cortes (segundos)
VIDEOCUT_MIN_CLIP=20
VIDEOCUT_MAX_CLIP=75

# VoiceStudio
VOICESTUDIO_URL=http://127.0.0.1:3900
# VOICESTUDIO_PROFILE=   # voz padrão para narrar ganchos (veja `videocut voicestudio`)

# DaVinci Resolve (só usado na versão Studio, para controle externo)
RESOLVE_SCRIPT_LIB=D:\fusionscript.dll
